<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Scoped specifically to DEBUG variant to support development LAN IPs (e.g., 192.168.x.x, 10.x.x.x) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
