<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/primary_dark">

    <!-- Native App Header Bar -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@color/primary"
        android:elevation="4dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_shield"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SpyAware"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="ANALYZER"
                    android:textColor="@color/accent_blue_light"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBackendAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="http://10.0.2.2:8000"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="middle" />
        </LinearLayout>

        <!-- Status Chip -->
        <LinearLayout
            android:id="@+id/btnStatusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_status_badge"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginEnd="6dp">

            <View
                android:id="@+id/viewStatusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_badge"
                android:backgroundTint="@color/warning_amber" />

            <TextView
                android:id="@+id/tvStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/status_checking"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Refresh Button -->
        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Refresh"
            app:tint="@color/text_primary" />

        <!-- Settings Button -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/settings_title"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- Page Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="@color/primary"
        android:progressTint="@color/accent_blue"
        android:visibility="gone" />

    <!-- Content Area: WebView + Error Overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Error / Offline State Overlay -->
        <ScrollView
            android:id="@+id/layoutError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="@color/primary_dark"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/error_red"
                    android:contentDescription="Warning" />

                <TextView
                    android:id="@+id/tvErrorTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/err_cannot_reach_backend"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textAlignment="center" />

                <TextView
                    android:id="@+id/tvErrorDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Failed to connect to backend server at http://10.0.2.2:8000"
                    android:textColor="@color/error_red"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textAlignment="center" />

                <!-- Helpful connection advice card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_status_badge"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Troubleshooting Guide:"
                        android:textColor="@color/accent_blue_light"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvErrorTroubleshooting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="1. Android Emulator: Use http://10.0.2.2:8000\n2. USB Device: Run 'adb reverse tcp:8000 tcp:8000' and use http://localhost:8000\n3. LAN/Wi-Fi: Use Ubuntu host LAN IP (e.g. http://192.168.x.x:8000)\n4. Verify backend is running: 'uvicorn backend.main:app --host 0.0.0.0 --port 8000'"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="20dp">

                    <Button
                        android:id="@+id/btnRetryConnection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_retry"
                        android:backgroundTint="@color/accent_blue"
                        android:textColor="@color/white"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnConfigureBackend"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_configure"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Security Modules Section -->
    <LinearLayout
        android:id="@+id/layoutModulesSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_dark"
        android:elevation="6dp">

        <!-- Modules Section Header Bar (Collapsible toggle) -->
        <LinearLayout
            android:id="@+id/btnToggleModules"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_shield"
                app:tint="@color/accent_blue_light"
                android:contentDescription="Modules" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="ENGINES &amp; SUBSYSTEMS"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvModulesHeaderSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Engines &amp; Subsystems Ready"
                android:textColor="@color/accent_blue_light"
                android:textSize="11sp"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:id="@+id/ivModulesChevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/text_secondary"
                android:contentDescription="Toggle modules view" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/surface_border" />

        <!-- Cards Container (Expanded content) -->
        <LinearLayout
            android:id="@+id/layoutModulesCardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:visibility="visible">

            <!-- ANALYSIS ENGINE CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAnalysisEngine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/primary"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/surface_border"
                app:strokeWidth="1dp"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_status_badge"
                            android:padding="6dp"
                            android:src="@drawable/ic_shield"
                            app:tint="@color/accent_blue_light"
                            android:contentDescription="Analysis Engine" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:id="@+id/tvAnalysisEngineTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Analysis Engine"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAnalysisEngineSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Analyze installed Android applications for potential security risks."
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Analysis Engine Status Badge -->
                        <LinearLayout
                            android:id="@+id/badgeAnalysisEngineStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_status_badge"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp">

                            <View
                                android:id="@+id/dotAnalysisEngineStatus"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/bg_status_badge"
                                android:backgroundTint="@color/success_green" />

                            <TextView
                                android:id="@+id/tvAnalysisEngineStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Available"
                                android:textColor="@color/success_green"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Analysis Engine Action Button -->
                    <Button
                        android:id="@+id/btnAnalysisEngineAction"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:text="OPEN ANALYZER"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/surface_dark"
                        android:textColor="@color/accent_blue_light"
                        app:strokeColor="@color/accent_blue"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MODULE 4 CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardModule4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/primary"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/surface_border"
                app:strokeWidth="1dp"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_status_badge"
                            android:padding="6dp"
                            android:src="@drawable/ic_network"
                            app:tint="@color/accent_blue_light"
                            android:contentDescription="Network Security Analyzer" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:id="@+id/tvModule4Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Network Security Analyzer"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvModule4Subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Network monitoring and security analysis"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Module 4 Status Badge -->
                        <LinearLayout
                            android:id="@+id/badgeModule4Status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_status_badge"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp">

                            <View
                                android:id="@+id/dotModule4Status"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/bg_status_badge"
                                android:backgroundTint="@color/warning_amber" />

                            <TextView
                                android:id="@+id/tvModule4Status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Not Installed"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Module 4 Action Button -->
                    <Button
                        android:id="@+id/btnModule4Action"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:text="OPEN MODULE"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/accent_blue"
                        android:textColor="@color/white"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MODULE 5 CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardModule5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/primary"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/surface_border"
                app:strokeWidth="1dp"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_status_badge"
                            android:padding="6dp"
                            android:src="@drawable/ic_bluetooth"
                            app:tint="@color/accent_blue_light"
                            android:contentDescription="BLE Surveillance Detector" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:id="@+id/tvModule5Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BLE Surveillance Detector"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvModule5Subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Detect nearby Bluetooth Low Energy devices and investigate suspicious device behavior."
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Module 5 Status Badge -->
                        <LinearLayout
                            android:id="@+id/badgeModule5Status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_status_badge"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp">

                            <View
                                android:id="@+id/dotModule5Status"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/bg_status_badge"
                                android:backgroundTint="@color/warning_amber" />

                            <TextView
                                android:id="@+id/tvModule5Status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Not Installed"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Module 5 Action Button -->
                    <Button
                        android:id="@+id/btnModule5Action"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:text="OPEN MODULE"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/accent_blue"
                        android:textColor="@color/white"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
