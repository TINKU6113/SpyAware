<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient Orbital Aura -->
    <path
        android:pathData="M 54,28 A 26,26 0 1,1 53.99,28 Z"
        android:strokeColor="#2034D399"
        android:strokeWidth="8"
        android:fillColor="#00000000" />

    <!-- Outer Swirling Flow Orbit Ribbon -->
    <path
        android:pathData="M 54,31 A 23,23 0 1,1 35.8,40.1"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="32"
                android:startY="32"
                android:endX="76"
                android:endY="76"
                android:type="linear">
                <item android:color="#FF6EE7B7" android:offset="0.0" />
                <item android:color="#FF34D399" android:offset="0.5" />
                <item android:color="#FF10B981" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Counter-Flow Harmonics -->
    <path
        android:pathData="M 40,68 A 19,19 0 0,0 71.5,61.2"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="40"
                android:startY="68"
                android:endX="72"
                android:endY="60"
                android:type="linear">
                <item android:color="#FF52B788" android:offset="0.0" />
                <item android:color="#8034D399" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Focus Halo Ring -->
    <path
        android:pathData="M 54,41.5 A 12.5,12.5 0 1,1 53.99,41.5 Z"
        android:strokeColor="#4D86D6B3"
        android:strokeWidth="1.8"
        android:fillColor="#00000000" />

    <!-- Pure Brilliant Central Focus Circle -->
    <path
        android:pathData="M 54,45 A 9,9 0 1,1 53.99,45 Z"
        android:fillColor="#FFFFFF" />
</vector>