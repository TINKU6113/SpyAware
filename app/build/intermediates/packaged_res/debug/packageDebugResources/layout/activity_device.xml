<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvAnalysisTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BLE DEVICE ANALYSIS"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/tvAnalysisDevice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Device"
        android:textSize="18sp"
        android:paddingBottom="10dp" />
    <TextView
        android:id="@+id/tvAnalysisClassification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Classification: UNKNOWN"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingBottom="10dp" />

    <!-- Radar will go here -->

    <TextView
        android:id="@+id/tvAnalysisRssi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RSSI: --"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvAnalysisDistance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Estimated Distance: --"
        android:textSize="16sp" />
    <TextView
        android:id="@+id/tvAnalysisMethod"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Method: --"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvAnalysisConfidence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confidence: --"
        android:textSize="16sp" />
    <TextView
        android:id="@+id/tvAnalysisProximity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Proximity: --"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvAnalysisTrend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trend: --"
        android:textSize="16sp" />
    <com.example.spyaware.activities.RadarView
        android:id="@+id/radarView"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />
    <Button
        android:id="@+id/btnCalibrate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="CALIBRATE AT 1 METRE" />

</LinearLayout>